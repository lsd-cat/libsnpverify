{
  "name": "snpverify",
  "version": "0.1.0",
  "description": "AMD SEV-SNP attestation report verifier for browsers and Node. Pure TypeScript on WebCrypto, no dependencies.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "fetch-roots": "node scripts/fetch-roots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "eslint": "^10.12.0",
    "typescript": "^5.6",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lsd-cat/snpverify",
    "directory": "ts"
  }
}
